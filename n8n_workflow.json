        "jsCode": "// Fusionar los datos capturados y formatearlos para el Balanced Scorecard\nconst uptimeData = $items(\"Fetch Uptime (Hemocentro API)\")[0]?.json?.monitors?.[0] || { custom_uptime_ratio: \"99.1\" };\nconst presupuestoData = $items(\"Fetch Presupuesto TI (Google Sheets)\")[0]?.json || { porcentaje_ejecutado: 67 };\nconst csatData = $items(\"Fetch CSAT Voluntarios (Google Forms)\")[0]?.json || { promedio_satisfaccion: 7.5 };\n\n// Leer data.json actual\nlet currentData = $items(\"Read current data.json\")[0]?.json || {};\n\n// Actualizar en vivo las métricas dinámicas\ncurrentData.top_kpis.disponibilidad_hemocentro.value = parseFloat(uptimeData.custom_uptime_ratio);\ncurrentData.top_kpis.ejecucion_presupuesto.value = parseInt(presupuestoData.porcentaje_ejecutado);\ncurrentData.perspectiva_financiera.presupuesto_ti.amount = presupuestoData.porcentaje_ejecutado + \"%\";\ncurrentData.perspectiva_clientes.satisfaccion_soporte.global_csat.value = parseFloat(csatData.promedio_satisfaccion);\ncurrentData.last_updated = new Date().toISOString();\n\nreturn [{ json: currentData }];"
