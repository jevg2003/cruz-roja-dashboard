---
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Optimization -->
    <title>Dashboard Estratégico CIO | Cruz Roja Valle del Cauca - PETI 2026-2030</title>
    <meta name="description" content="Cuadro de Mando Integral y Dashboard Prescriptivo de Gobierno de TI para la Cruz Roja Colombiana - Seccional Valle del Cauca. Automatizado con n8n y alineado con ISO 38500." />
    
    <!-- CDNs Seguras para Iconos y Gráficos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
  </head>
  <body class="bg-cyber-dark text-slate-100 min-h-screen overflow-y-auto">
    
    <!-- Matrix Scan Line Background Overlay -->
    <div class="scan-line-overlay"></div>
    
    <!-- Top Glowing Border Line -->
    <div class="h-1 w-full bg-gradient-to-r from-brand-red via-neon-amber to-neon-green"></div>

    <!-- MAIN CONTAINER (Fluid Wide Layout - Uses all space) -->
    <div class="w-full px-4 md:px-8 py-6">
      
      <!-- HEADER SECTION -->
      <header class="glass-panel rounded-2xl p-5 mb-6 flex flex-col md:flex-row items-center justify-between gap-4 border-l-4 border-brand-red-neon shadow-lg w-full">
        <div class="flex items-center gap-4">
          <!-- Institutional Shield (Red Cross SVG Shield) -->
          <div class="relative w-14 h-14 bg-red-600 rounded-xl flex items-center justify-center shadow-md shadow-red-900/50 animate-pulse">
            <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 10.5h-5.5V5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v5.5H5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h5.5V19c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-5.5H19c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5z"/>
            </svg>
            <div class="absolute -inset-1 border border-brand-red-neon/30 rounded-xl pointer-events-none scale-105"></div>
          </div>
          <div>
            <h1 class="cyber-title text-xl md:text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-slate-400">
              Dashboard Estratégico CIO
            </h1>
            <p class="text-xs md:text-sm font-semibold text-brand-red-neon tracking-widest cyber-title mt-0.5">
              CRUZ ROJA COLOMBIA • SECCIONAL VALLE DEL CAUCA • PETI 2026-2030
            </p>
          </div>
        </div>

        <!-- Executive Date & Prescriptive Tag -->
        <div class="flex flex-col items-end text-right">
          <div class="flex items-center gap-2 bg-red-950/45 px-3.5 py-1.5 rounded-full border border-brand-red-neon/40 shadow-inner">
            <span class="w-2.5 h-2.5 bg-brand-red-neon rounded-full animate-ping"></span>
            <span class="text-xs font-mono font-bold tracking-widest text-brand-red-neon cyber-title">ABRIL 2026</span>
          </div>
          <span class="text-[10px] text-slate-500 font-mono tracking-widest uppercase mt-2" id="sync-status">
            Sincronizado vía n8n: 13:25 (Local)
          </span>
        </div>
      </header>

      <!-- TWO COLUMN LAYOUT (Left Column: ISO 38500 Console / Right Column: Dashboards) -->
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start w-full">
        
        <!-- ================= LEFT PANEL: CONSOLA GOBIERNO TI ISO 38500 ================= -->
        <aside class="xl:col-span-4 space-y-6 xl:sticky xl:top-6">
          <div class="glass-panel p-5 rounded-2xl border-t-4 border-brand-red shadow-2xl relative overflow-hidden">
            
            <div class="flex justify-between items-center border-b border-slate-800 pb-3 gap-2">
              <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-scale-balanced text-brand-red-neon"></i>
                <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider cyber-title">Gobernanza ISO 38500</h3>
              </div>
              <button id="btn-reset-data" class="text-[9px] font-bold text-slate-400 hover:text-white border border-slate-700 hover:border-slate-500 bg-slate-800/80 px-2 py-1 rounded transition-all cursor-pointer flex items-center gap-1 flex-shrink-0">
                <i class="fa-solid fa-rotate-left"></i> Restablecer
              </button>
            </div>
            
            <p class="text-[10px] text-slate-400 mt-2.5 leading-relaxed">
              Gobierna la infraestructura de la Cruz Roja evaluando necesidades, dirigiendo planes y monitoreando resultados en tiempo real según la norma **ISO/IEC 38500**.
            </p>

            <!-- ISO 38500 STEPS (EVALUATE, DIRECT, MONITOR) -->
            <div class="space-y-4 mt-4">
              
              <!-- STEP 1: EVALUAR (Auditorías de TI) -->
              <div class="bg-slate-900/40 border border-slate-850 p-4 rounded-xl space-y-3">
                <span class="text-[9px] font-black text-cyan-400 uppercase tracking-widest cyber-title block flex items-center gap-1">
                  <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full"></span> 1. EVALUAR (Auditoría e Incidentes)
                </span>
                
                <div class="space-y-2 text-xs">
                  <!-- Question A -->
                  <label class="flex items-start gap-2.5 cursor-pointer text-slate-300 hover:text-slate-100">
                    <input type="checkbox" id="audit-servidores" class="mt-0.5 accent-brand-red-neon" />
                    <div>
                      <span class="font-semibold block text-[11px]">Auditar Servidores Locales</span>
                      <span class="text-[9px] text-slate-500 block leading-tight">Detecta obsolescencia crítica y riesgos de caídas del Hemocentro.</span>
                    </div>
                  </label>
                  
                  <!-- Question B -->
                  <label class="flex items-start gap-2.5 cursor-pointer text-slate-300 hover:text-slate-100">
                    <input type="checkbox" id="audit-seguridad" class="mt-0.5 accent-brand-red-neon" />
                    <div>
                      <span class="font-semibold block text-[11px]">Auditar Ciberseguridad e ISO 27001</span>
                      <span class="text-[9px] text-slate-500 block leading-tight">Evidencia vulnerabilidades a Ransomware y multas de Ley 1581.</span>
                    </div>
                  </label>

                  <!-- Question C -->
                  <label class="flex items-start gap-2.5 cursor-pointer text-slate-300 hover:text-slate-100">
                    <input type="checkbox" id="audit-procesos" class="mt-0.5 accent-brand-red-neon" />
                    <div>
                      <span class="font-semibold block text-[11px]">Encuesta de Satisfacción Voluntarios</span>
                      <span class="text-[9px] text-slate-500 block leading-tight">Evalúa la brecha de apropiación digital en las misiones.</span>
                    </div>
                  </label>
                </div>
              </div>

              <!-- STEP 2: DIRIGIR (Aprobación de Proyectos PETI) -->
              <div class="bg-slate-900/40 border border-slate-850 p-4 rounded-xl space-y-3">
                <span class="text-[9px] font-black text-brand-red-neon uppercase tracking-widest cyber-title block flex items-center gap-1">
                  <span class="w-1.5 h-1.5 bg-brand-red-neon rounded-full"></span> 2. DIRIGIR (Aprobaciones PETI)
                </span>
                
                <div class="space-y-3">
                  <!-- Project B1 -->
                  <div class="flex items-center justify-between border-b border-slate-900 pb-2">
                    <div>
                      <span class="font-semibold text-slate-200 text-[11px] block">Aprobar B1: CISO & SOC</span>
                      <span class="text-[9px] text-slate-500">Costo: <strong class="text-slate-400 font-mono">$45M</strong> | Mitiga ciberriesgos</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="dirigir-b1" class="sr-only peer" />
                      <div class="w-8 h-4.5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-450 after:border-slate-350 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-600 peer-checked:after:bg-white"></div>
                    </label>
                  </div>

                  <!-- Project B2 -->
                  <div class="flex items-center justify-between border-b border-slate-900 pb-2">
                    <div>
                      <span class="font-semibold text-slate-200 text-[11px] block">Aprobar B2: Azure Cloud Hybrid</span>
                      <span class="text-[9px] text-slate-500">Costo: <strong class="text-slate-400 font-mono">$80M</strong> | Resiliencia y Uptime</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="dirigir-b2" class="sr-only peer" />
                      <div class="w-8 h-4.5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-450 after:border-slate-350 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-600 peer-checked:after:bg-white"></div>
                    </label>
                  </div>

                  <!-- Project B3 -->
                  <div class="flex items-center justify-between border-b border-slate-900 pb-2">
                    <div>
                      <span class="font-semibold text-slate-200 text-[11px] block">Aprobar B3: API Gateway HL7</span>
                      <span class="text-[9px] text-slate-500">Costo: <strong class="text-slate-400 font-mono">$55M</strong> | Integra HeVa/Siesa</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="dirigir-b3" class="sr-only peer" />
                      <div class="w-8 h-4.5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-450 after:border-slate-350 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-600 peer-checked:after:bg-white"></div>
                    </label>
                  </div>

                  <!-- Project B7 -->
                  <div class="flex items-center justify-between border-b border-slate-900 pb-2">
                    <div>
                      <span class="font-semibold text-slate-200 text-[11px] block">Aprobar B7: Gobierno Datos</span>
                      <span class="text-[9px] text-slate-500">Costo: <strong class="text-slate-400 font-mono">$12M</strong> | Catálogo y roles</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="dirigir-b7" class="sr-only peer" />
                      <div class="w-8 h-4.5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-450 after:border-slate-350 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-600 peer-checked:after:bg-white"></div>
                    </label>
                  </div>

                  <!-- Project B8 -->
                  <div class="flex items-center justify-between border-b border-slate-900 pb-2">
                    <div>
                      <span class="font-semibold text-slate-200 text-[11px] block">Aprobar B8: Capacitación Teams</span>
                      <span class="text-[9px] text-slate-500">Costo: <strong class="text-slate-400 font-mono">$15M</strong> | Eleva madurez a 4.2</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="dirigir-b8" class="sr-only peer" />
                      <div class="w-8 h-4.5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-450 after:border-slate-350 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-600 peer-checked:after:bg-white"></div>
                    </label>
                  </div>

                  <!-- Project B5 -->
                  <div class="flex items-center justify-between">
                    <div>
                      <span class="font-semibold text-slate-200 text-[11px] block flex items-center gap-1">
                        Aprobar B5: Hemocentro 4.0
                      </span>
                      <span class="text-[9px] text-slate-500">Costo: <strong class="text-slate-400 font-mono">$75M</strong> | Portal Donación + App</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="dirigir-b5" class="sr-only peer" />
                      <div class="w-8 h-4.5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-450 after:border-slate-350 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-600 peer-checked:after:bg-white"></div>
                    </label>
                  </div>
                </div>
              </div>

              <!-- STEP 3: MONITOREAR (Alineación Financiera y Conformance) -->
              <div class="bg-slate-900/40 border border-slate-850 p-4 rounded-xl space-y-3">
                <span class="text-[9px] font-black text-neon-green uppercase tracking-widest cyber-title block flex items-center gap-1">
                  <span class="w-1.5 h-1.5 bg-neon-green rounded-full"></span> 3. MONITOREAR (Presupuesto & ISO 38500)
                </span>
                
                <!-- Financial Check in Control Panel -->
                <div class="space-y-2">
                  <div class="flex justify-between text-xs font-semibold">
                    <span class="text-slate-400 text-[10px]">Inversión Ejecutada PETI:</span>
                    <span class="font-mono text-slate-200 font-bold" id="sim-budget-cost">$60M / $330M</span>
                  </div>
                  <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden relative">
                    <div id="sim-budget-progress" class="h-full bg-neon-green" style="width: 18%;"></div>
                  </div>
                  <!-- Budget SLA warning message -->
                  <div id="sim-budget-warning" class="text-[9px] font-bold text-red-500 hidden bg-red-950/20 border border-red-900/30 p-1.5 rounded leading-tight">
                    ⚠️ SOBRE-EJECUCIÓN: Ha excedido el límite presupuestal del PETI de $330M COP. Ajuste sus directivas.
                  </div>
                </div>

                <!-- ISO 38500 Directive Compliance Rating -->
                <hr class="border-slate-800" />
                <div class="flex items-center justify-between text-xs pt-1">
                  <span class="text-slate-300 font-bold text-[9px] uppercase tracking-wider cyber-title">Cumplimiento ISO 38500:</span>
                  <span id="iso-38500-rating" class="font-mono font-bold text-red-500 bg-red-950/45 px-2 py-0.5 rounded border border-red-900/60 uppercase tracking-widest text-[9px]">EVALUANDO</span>
                </div>
              </div>

            </div>
          </div>
        </aside>

        <!-- ================= RIGHT PANEL: INTERACTIVE VIEWPORTS ================= -->
        <main class="xl:col-span-8 space-y-6 w-full">
          
          <!-- TOP METRIC STRIP (Now wider and responsive) -->
          <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 w-full">
            <!-- Madurez Digital -->
            <div class="glass-panel p-4 rounded-xl border-b-2 border-red-500/50 flex flex-col justify-between" id="strip-madurez">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Madurez Digital</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="cyber-value text-2xl font-black text-red-500" id="strip-madurez-val">2.8</span>
                <span class="text-xs text-slate-500">/5.0</span>
              </div>
            </div>
            <!-- ISO 27001 -->
            <div class="glass-panel p-4 rounded-xl border-b-2 border-red-500/50 flex flex-col justify-between" id="strip-iso">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Cumpl. ISO 27001</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="cyber-value text-2xl font-black text-red-500" id="strip-iso-val">45%</span>
              </div>
            </div>
            <!-- Disp. Hemocentro -->
            <div class="glass-panel p-4 rounded-xl border-b-2 border-emerald-500/50 flex flex-col justify-between" id="strip-uptime">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Disp. Hemocentro</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="cyber-value text-2xl font-black text-emerald-400 animate-pulse" id="strip-uptime-val">99.1%</span>
              </div>
            </div>
            <!-- Ejec. Presupuestal -->
            <div class="glass-panel p-4 rounded-xl border-b-2 border-amber-500/50 flex flex-col justify-between" id="strip-presupuesto">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Ejec. Presupuestal TI</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="cyber-value text-2xl font-black text-amber-400" id="strip-presupuesto-val">67%</span>
              </div>
            </div>
            <!-- CISO -->
            <div class="glass-panel p-4 rounded-xl border-b-2 border-red-500/50 flex flex-col justify-between" id="strip-ciso">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">CISO Designado</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="cyber-value text-2xl font-black text-red-500" id="strip-ciso-val">NO</span>
              </div>
            </div>
            <!-- Ingresos -->
            <div class="glass-panel p-4 rounded-xl border-b-2 border-emerald-500/50 flex flex-col justify-between">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Ingresos Hemocentro</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="cyber-value text-2xl font-black text-emerald-400" id="strip-ingresos-val">$771M</span>
                <span class="text-xs text-slate-500">COP</span>
              </div>
            </div>
          </section>

          <!-- NAVIGATION TABS -->
          <nav class="glass-panel rounded-xl p-1.5 flex flex-wrap md:flex-nowrap gap-1 w-full">
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer flex items-center justify-center gap-2 bg-red-600/90 text-white glow-red" data-tab="mapa">
              <i class="fa-solid fa-map-location-dot"></i> Mapa BSC
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="financiero">
              <i class="fa-solid fa-chart-line"></i> Financiero
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="clientes">
              <i class="fa-solid fa-hand-holding-heart"></i> Clientes
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="procesos">
              <i class="fa-solid fa-shield-halved"></i> Procesos
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="aprendizaje">
              <i class="fa-solid fa-graduation-cap"></i> Aprendizaje
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-brand-red-neon border border-transparent hover:border-brand-red-neon/30" data-tab="prescripcion">
              <i class="fa-solid fa-bolt"></i> Prescripción
            </button>
          </nav>

          <!-- VIEWPORT CONTAINER -->
          <div class="w-full relative">

            <!-- VIEW 1: MAPA BSC -->
            <section id="view-mapa" class="tab-view block space-y-6 w-full">
              
              <!-- Route Filtration Console -->
              <div class="glass-panel p-4 rounded-xl flex flex-col lg:flex-row items-center justify-between gap-4 w-full">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider cyber-title">Filtrar Ruta Causal:</span>
                </div>
                <div class="flex flex-wrap gap-2 w-full lg:w-auto justify-start lg:justify-end">
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-slate-700 bg-slate-800/80 text-white cursor-pointer active" data-route="all">
                    Todas las rutas
                  </button>
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-emerald-900/60 bg-emerald-950/20 text-emerald-400 cursor-pointer hover:bg-emerald-950/40" data-route="r1">
                    🔴 Ruta 1 - Hemocentro
                  </button>
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-red-900/60 bg-red-950/60 text-brand-red-neon cursor-pointer hover:bg-red-950/40" data-route="r2">
                    🔵 Ruta 2 - Ciberseguridad
                  </button>
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-amber-900/60 bg-amber-950/20 text-amber-400 cursor-pointer hover:bg-amber-950/40" data-route="r3">
                    🟡 Ruta 3 - Educación
                  </button>
                </div>
                <span class="text-[10px] text-slate-500 hidden xl:block italic">Haz clic en un objetivo para auditar su cadena causal</span>
              </div>

              <!-- BSC Strategy Map Container -->
              <div class="w-full overflow-x-auto rounded-2xl border border-slate-800/50 shadow-2xl">
                <div class="relative glass-panel p-6 min-w-[950px] w-full">
                  
                  <!-- SVG Overlay for Connecting Laser Paths -->
                  <svg id="svg-paths" class="absolute inset-0 w-full h-full pointer-events-none z-0">
                    <defs>
                      <linearGradient id="laser-grad-r1" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#00e676" stop-opacity="0.9"/>
                        <stop offset="100%" stop-color="#ff3344" stop-opacity="0.9"/>
                      </linearGradient>
                      <linearGradient id="laser-grad-r2" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#ff9100" stop-opacity="0.9"/>
                        <stop offset="100%" stop-color="#2979ff" stop-opacity="0.9"/>
                      </linearGradient>
                      <linearGradient id="laser-grad-r3" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#2979ff" stop-opacity="0.9"/>
                        <stop offset="100%" stop-color="#ffab00" stop-opacity="0.9"/>
                      </linearGradient>
                    </defs>
                  </svg>

