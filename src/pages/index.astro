---
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Optimization -->
    <title>Dashboard Estratégico CIO | Cruz Roja Valle del Cauca - PETI 2026-2030</title>
    <meta name="description" content="Cuadro de Mando Integral y Dashboard Prescriptivo de Gobierno de TI para la Cruz Roja Colombiana - Seccional Valle del Cauca. Automatizado con n8n y alineado con ISO 38500." />
    
    <!-- CDNs Seguras para Iconos y Gráficos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
  </head>
  <body class="bg-cyber-dark text-slate-100 min-h-screen overflow-y-auto">
    
    <!-- Matrix Scan Line Background Overlay -->
    <div class="scan-line-overlay"></div>
    
    <!-- Top Glowing Border Line -->
    <div class="h-1 w-full bg-gradient-to-r from-brand-red via-neon-amber to-neon-green"></div>

    <!-- MAIN CONTAINER (Fluid Wide Layout - Uses all space) -->
    <div class="w-full px-4 md:px-8 py-6">
      
      <!-- HEADER SECTION -->
      <header class="glass-panel rounded-2xl p-5 mb-6 flex flex-col md:flex-row items-center justify-between gap-4 border-l-4 border-brand-red-neon shadow-lg w-full">
        <div class="flex items-center gap-4">
          <!-- Institutional Shield (Red Cross SVG Shield) -->
          <div class="relative w-14 h-14 bg-white border border-slate-200 rounded-xl flex items-center justify-center shadow-lg shadow-slate-300/40 hover:scale-105 transition-all duration-300 cursor-pointer group">
            <svg class="w-9 h-9 text-brand-red group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 10.5h-5.5V5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v5.5H5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h5.5V19c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-5.5H19c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5z"/>
            </svg>
            <div class="absolute -inset-1 border border-white rounded-xl pointer-events-none shadow-[0_0_10px_rgba(15,23,42,0.03)]"></div>
          </div>
          <div>
            <h1 class="cyber-title text-xl md:text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-800 to-slate-600">
              Dashboard Estratégico CIO
            </h1>
            <p class="text-xs md:text-sm font-semibold text-brand-red tracking-widest cyber-title mt-0.5">
              CRUZ ROJA COLOMBIA • SECCIONAL VALLE DEL CAUCA • PETI 2026-2030
            </p>
          </div>
        </div>

        <!-- Executive Date & Prescriptive Tag -->
        <div class="flex flex-col items-end text-right">
          <div class="flex items-center gap-2 bg-red-50 px-3.5 py-1.5 rounded-full border border-red-200 shadow-sm">
            <span class="w-2.5 h-2.5 bg-brand-red rounded-full animate-ping"></span>
            <span class="text-xs font-mono font-bold tracking-widest text-brand-red cyber-title">ABRIL 2026</span>
          </div>
          <span class="text-[10px] text-slate-500 font-mono tracking-widest uppercase mt-2" id="sync-status">
            Sincronizado vía n8n: 13:25 (Local)
          </span>
        </div>
      </header>


        <!-- ================= RIGHT PANEL: INTERACTIVE VIEWPORTS ================= -->
        <main class="xl:col-span-8 space-y-6 w-full">
          
          <!-- TOP METRIC STRIP (Now wider and responsive) -->
          <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 w-full">
            <!-- Madurez Digital -->
            <div class="glass-panel p-4.5 rounded-xl border-b-2 border-red-500/50 flex flex-col justify-between" id="strip-madurez">
              <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Madurez Digital</span>
              <div class="flex items-baseline gap-1 mt-1.5">
                <span class="cyber-value text-3xl font-black text-red-500" id="strip-madurez-val">2.8</span>
                <span class="text-xs text-slate-500">/5.0</span>
              </div>
            </div>
            <!-- ISO 27001 -->
            <div class="glass-panel p-4.5 rounded-xl border-b-2 border-red-500/50 flex flex-col justify-between" id="strip-iso">
              <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Cumpl. ISO 27001</span>
              <div class="flex items-baseline gap-1 mt-1.5">
                <span class="cyber-value text-3xl font-black text-red-500" id="strip-iso-val">45%</span>
              </div>
            </div>
            <!-- Disp. Hemocentro -->
            <div class="glass-panel p-4.5 rounded-xl border-b-2 border-emerald-500/50 flex flex-col justify-between" id="strip-uptime">
              <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Disp. Hemocentro</span>
              <div class="flex items-baseline gap-1 mt-1.5">
                <span class="cyber-value text-3xl font-black text-emerald-400 animate-pulse" id="strip-uptime-val">99.1%</span>
              </div>
            </div>
            <!-- Ejec. Presupuesto -->
            <div class="glass-panel p-4.5 rounded-xl border-b-2 border-amber-500/50 flex flex-col justify-between" id="strip-presupuesto">
              <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Ejec. Presupuestal TI</span>
              <div class="flex items-baseline gap-1 mt-1.5">
                <span class="cyber-value text-3xl font-black text-amber-400" id="strip-presupuesto-val">67%</span>
              </div>
            </div>
            <!-- CISO -->
            <div class="glass-panel p-4.5 rounded-xl border-b-2 border-red-500/50 flex flex-col justify-between" id="strip-ciso">
              <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">CISO Designado</span>
              <div class="flex items-baseline gap-1 mt-1.5">
                <span class="cyber-value text-3xl font-black text-red-500" id="strip-ciso-val">NO</span>
              </div>
            </div>
            <!-- Ingresos -->
            <div class="glass-panel p-4.5 rounded-xl border-b-2 border-emerald-500/50 flex flex-col justify-between">
              <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block">Ingresos Hemocentro</span>
              <div class="flex items-baseline gap-1 mt-1.5">
                <span class="cyber-value text-3xl font-black text-emerald-400" id="strip-ingresos-val">$771M</span>
                <span class="text-xs text-slate-500">COP</span>
              </div>
            </div>
          </section>

          <!-- NAVIGATION TABS -->
          <nav class="glass-panel rounded-xl p-1.5 flex flex-wrap md:flex-nowrap gap-1 w-full">
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer flex items-center justify-center gap-2 bg-red-600/90 text-white glow-red" data-tab="autodiagnostico">
              <i class="fa-solid fa-brain text-cyan-300 animate-pulse"></i> Autodiagnóstico IA
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="mapa">
              <i class="fa-solid fa-map-location-dot"></i> Mapa BSC
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="financiero">
              <i class="fa-solid fa-chart-line"></i> Financiero
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="clientes">
              <i class="fa-solid fa-hand-holding-heart"></i> Clientes
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="procesos">
              <i class="fa-solid fa-shield-halved"></i> Procesos
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="aprendizaje">
              <i class="fa-solid fa-graduation-cap"></i> Aprendizaje
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white" data-tab="gobernanza">
              <i class="fa-solid fa-scale-balanced"></i> Directivas ISO 38500
            </button>
            <button class="nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-brand-red-neon border border-transparent hover:border-brand-red-neon/30" data-tab="prescripcion">
              <i class="fa-solid fa-bolt"></i> Prescripción
            </button>
          </nav>

          <!-- VIEWPORT CONTAINER -->
          <div class="w-full relative">

            <!-- VIEW 0: AUTODIAGNÓSTICO IA -->
            <section id="view-autodiagnostico" class="tab-view block space-y-6 w-full">
              
              <!-- Explanatory Box -->
              <div class="glass-panel p-5 rounded-2xl border-l-4 border-cyan-400 shadow-md w-full relative overflow-hidden bg-slate-900/10">
                <div class="flex justify-between items-center border-b border-slate-800 pb-3 gap-2">
                  <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-brain text-cyan-400 animate-pulse text-lg"></i>
                    <h3 class="text-sm font-bold text-slate-200 uppercase tracking-wider cyber-title">Autodiagnóstico de Gobernanza TI</h3>
                  </div>
                  <button id="btn-reset-data" class="text-xs font-bold text-slate-300 hover:text-white border border-slate-700 hover:border-slate-500 bg-slate-800/80 px-2.5 py-1 rounded transition-all cursor-pointer flex items-center gap-1 flex-shrink-0">
                    <i class="fa-solid fa-rotate-left"></i> Restablecer
                  </button>
                </div>
                <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                  Evalúa las 10 dimensiones de la norma <strong>ISO 38500</strong>. Selecciona una calificación del <strong>0 al 5</strong>. Tus respuestas inyectarán de forma automática los proyectos aprobados, auditorías activas y modificarán todas las variables del PETI de de inmediato.
                </p>
              </div>

              <!-- 10 Questions Grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="diagnostic-questions-grid">
                <!-- Loaded dynamically by diagnostic.js -->
              </div>

              <!-- Action Bar at the bottom -->
              <div class="glass-panel p-4 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-4 w-full">
                <div>
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block cyber-title">Sincronización con Automatización local</span>
                  <p class="text-xs text-slate-500 mt-1 font-semibold">Envía tus respuestas al servidor de n8n para generar el reporte de brechas PDF ejecutivo.</p>
                </div>
                <button id="btn-send-n8n-webhook" class="w-full sm:w-auto py-3 px-6 rounded-xl text-xs font-bold uppercase tracking-wider border border-cyan-500/40 bg-cyan-950/20 hover:bg-cyan-950/40 text-cyan-400 shadow-md hover:scale-[1.01] transition-all cursor-pointer flex items-center justify-center gap-2">
                  <i class="fa-solid fa-paper-plane animate-bounce"></i> Enviar Diagnóstico a n8n
                </button>
              </div>

            </section>

            <!-- VIEW 1: MAPA BSC -->
            <section id="view-mapa" class="tab-view hidden space-y-6 w-full">
              
              <!-- Route Filtration Console -->
              <div class="glass-panel p-4 rounded-xl flex flex-col lg:flex-row items-center justify-between gap-4 w-full">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider cyber-title">Filtrar Ruta Causal:</span>
                </div>
                <div class="flex flex-wrap gap-2 w-full lg:w-auto justify-start lg:justify-end">
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-slate-700 bg-slate-800/80 text-white cursor-pointer active" data-route="all">
                    Todas las rutas
                  </button>
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-emerald-900/60 bg-emerald-950/20 text-emerald-400 cursor-pointer hover:bg-emerald-950/40" data-route="r1">
                    🔴 Ruta 1 - Hemocentro
                  </button>
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-red-900/60 bg-red-950/60 text-brand-red-neon cursor-pointer hover:bg-red-950/40" data-route="r2">
                    🔵 Ruta 2 - Ciberseguridad
                  </button>
                  <button class="route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-amber-900/60 bg-amber-950/20 text-amber-400 cursor-pointer hover:bg-amber-950/40" data-route="r3">
                    🟡 Ruta 3 - Educación
                  </button>
                </div>
                <span class="text-[10px] text-slate-500 hidden xl:block italic">Haz clic en un objetivo para auditar su cadena causal</span>
              </div>

              <!-- BSC Strategy Map Container -->
              <div class="w-full overflow-x-auto rounded-2xl border border-slate-800/50 shadow-2xl">
                <div class="relative glass-panel p-6 min-w-[950px] w-full">
                  
                  <!-- SVG Overlay for Connecting Laser Paths -->
                  <svg id="svg-paths" class="absolute inset-0 w-full h-full pointer-events-none z-0">
                    <defs>
                      <linearGradient id="laser-grad-r1" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#00e676" stop-opacity="0.9"/>
                        <stop offset="100%" stop-color="#ff3344" stop-opacity="0.9"/>
                      </linearGradient>
                      <linearGradient id="laser-grad-r2" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#ff9100" stop-opacity="0.9"/>
                        <stop offset="100%" stop-color="#2979ff" stop-opacity="0.9"/>
                      </linearGradient>
                      <linearGradient id="laser-grad-r3" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#2979ff" stop-opacity="0.9"/>
                        <stop offset="100%" stop-color="#ffab00" stop-opacity="0.9"/>
                      </linearGradient>
                    </defs>
                  </svg>

                  <!-- Grid Rows (4 Perspectives) -->
                  <div class="relative z-10 space-y-8">
                    
                    <!-- PERSPECTIVA 1: CLIENTES Y BENEFICIARIOS -->
                    <div class="grid grid-cols-12 items-center gap-4">
                      <div class="col-span-2 bg-red-950/40 border border-brand-red-neon/30 p-4 rounded-xl text-center self-stretch flex flex-col justify-center shadow-md">
                        <span class="text-xs font-bold text-brand-red-neon uppercase tracking-widest cyber-title block">Clientes & Beneficiarios</span>
                        <span class="text-[9px] text-slate-500 mt-1 italic block">El para quién</span>
                      </div>
                      <div class="col-span-10 grid grid-cols-3 gap-4">
                        <!-- C1 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-emerald-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-c1" data-obj="c1">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Elevar experiencia del donante y disponibilidad Hemocentro 24/7</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Disponibilidad</span>
                            <span class="text-xs font-mono font-bold text-emerald-400" id="card-c1-kpi">99.1% disp.</span>
                          </div>
                        </div>
                        <!-- C2 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-amber-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-c2" data-obj="c2">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Fortalecer confianza de hospitales y EPS aliados</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Confiabilidad TI</span>
                            <span class="text-xs font-mono font-bold text-amber-400" id="card-c2-kpi">Confianza 70%</span>
                          </div>
                        </div>
                        <!-- C3 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-red-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-c3" data-obj="c3">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Retener y escalar mercado educativo con oferta digital</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Portal Educativo</span>
                            <span class="text-xs font-mono font-bold text-red-500" id="card-c3-kpi">Portal 0%</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- PERSPECTIVA 2: PROCESOS INTERNOS -->
                    <div class="grid grid-cols-12 items-center gap-4">
                      <div class="col-span-2 bg-blue-950/40 border border-blue-500/30 p-4 rounded-xl text-center self-stretch flex flex-col justify-center shadow-md">
                        <span class="text-xs font-bold text-blue-400 uppercase tracking-widest cyber-title block">Procesos Internos</span>
                        <span class="text-[9px] text-slate-500 mt-1 italic block">Excelencia operativa</span>
                      </div>
                      <div class="col-span-10 grid grid-cols-4 gap-4">
                        <!-- P1 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-slate-600 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-p1" data-obj="p1">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Migrar infraestructura crítica a Cloud Azure híbrido</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Migración</span>
                            <span class="text-xs font-mono font-bold text-slate-400" id="card-p1-kpi">Migración 0%</span>
                          </div>
                        </div>
                        <!-- P2 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-red-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-p2" data-obj="p2">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Implementar ciberseguridad integral (SOC, DRP, ISO)</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: ISO 27001</span>
                            <span class="text-xs font-mono font-bold text-red-500" id="card-p2-kpi">ISO 45%</span>
                          </div>
                        </div>
                        <!-- P3 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-red-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-p3" data-obj="p3">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">API Gateway: eliminar islas de información</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Integración</span>
                            <span class="text-xs font-mono font-bold text-red-500" id="card-p3-kpi">Integración 0%</span>
                          </div>
                        </div>
                        <!-- P4 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-amber-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-p4" data-obj="p4">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Digitalizar procesos educativos y soporte</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Trámites en línea</span>
                            <span class="text-xs font-mono font-bold text-amber-400" id="card-p4-kpi">Trámites 30%</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- PERSPECTIVA 3: APRENDIZAJE Y CRECIMIENTO -->
                    <div class="grid grid-cols-12 items-center gap-4">
                      <div class="col-span-2 bg-emerald-950/40 border border-emerald-500/30 p-4 rounded-xl text-center self-stretch flex flex-col justify-center shadow-md">
                        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest cyber-title block">Aprendizaje & Crecimiento</span>
                        <span class="text-[9px] text-slate-500 mt-1 italic block">Talento e innovación</span>
                      </div>
                      <div class="col-span-10 grid grid-cols-3 gap-4">
                        <!-- A1 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-red-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-a1" data-obj="a1">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Elevar madurez digital del personal de 2.8 a 4.2</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Madurez</span>
                            <span class="text-xs font-mono font-bold text-red-500" id="card-a1-kpi">Madurez 2.8</span>
                          </div>
                        </div>
                        <!-- A2 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-red-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-a2" data-obj="a2">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Establecer gobierno TI formal (CISO, COBIT)</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: CISO/COBIT</span>
                            <span class="text-xs font-mono font-bold text-red-500" id="card-a2-kpi">Sin CISO</span>
                          </div>
                        </div>
                        <!-- A3 -->
                        <div class="bsc-card glass-panel p-4 rounded-xl border-l-4 border-amber-500 cursor-pointer shadow-lg hover:translate-y-[-2px]" id="node-a3" data-obj="a3">
                          <h4 class="text-xs font-bold text-slate-100 leading-tight">Fomentar cultura de innovación y pilotos</h4>
                          <div class="flex items-center justify-between mt-3">
                            <span class="text-[9px] text-slate-400">KPI: Pilotos Anuales</span>
                            <span class="text-xs font-mono font-bold text-amber-400" id="card-a3-kpi">Iniciativas 1</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- PERSPECTIVA 4: FINANCIERO / BASE HABILITADORA -->
                    <div class="grid grid-cols-12 items-center gap-4">
                      <div class="col-span-2 bg-amber-950/40 border border-amber-500/30 p-4 rounded-xl text-center self-stretch flex flex-col justify-center shadow-md">
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest cyber-title block">Financiero (ONG)</span>
                        <span class="text-[9px] text-slate-500 mt-1 italic block">Base habilitadora</span>
                      </div>
