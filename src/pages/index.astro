      // SUB-RENDERERS & HELPERS
      function updateTopKpi(id, value, suffix, status) {
        const valEl = document.getElementById(`strip-${id}-val`);
        const stripEl = document.getElementById(`strip-${id}`);
        if (valEl) valEl.textContent = value;
        if (stripEl) {
          let borderCol = 'border-red-500/50';
          if (status === 'success') borderCol = 'border-emerald-500/50';
          else if (status === 'warning') borderCol = 'border-amber-500/50';
          
          stripEl.className = `glass-panel p-4 rounded-xl border-b-2 ${borderCol} flex flex-col justify-between`;
        }
      }

      function updateBscCardKpi(id, text, status) {
        const el = document.getElementById(`card-${id}-kpi`);
        const cardEl = document.getElementById(`node-${id}`);
        if (el) {
          el.textContent = text;
          if (status === 'success') el.className = 'text-xs font-mono font-bold text-emerald-400';
          else if (status === 'warning') el.className = 'text-xs font-mono font-bold text-amber-400';
          else el.className = 'text-xs font-mono font-bold text-red-500';
        }
        if (cardEl) {
          let borderCol = 'border-red-500';
          if (status === 'success') borderCol = 'border-emerald-500';
          else if (status === 'warning') borderCol = 'border-amber-500';
          else if (status === 'neutral') borderCol = 'border-slate-600';
          
          cardEl.className = `bsc-card glass-panel p-4 rounded-xl border-l-4 ${borderCol} cursor-pointer shadow-lg hover:translate-y-[-2px]`;
        }
      }

      function renderCsatItem(title, value, target, statusText, status, action, percentWidth) {
        return `
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs font-semibold">
              <span class="text-slate-350 font-bold uppercase tracking-wider text-[9px] cyber-title">${title}</span>
              <span class="${getBadgeClass(status)} text-[8px] font-bold px-1.5 py-0.5 rounded uppercase">${statusText}</span>
            </div>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="cyber-value text-2xl font-black ${status === 'success' ? 'text-emerald-400' : status === 'warning' ? 'text-amber-400' : 'text-red-500'}">${value}</span>
              <span class="text-[9px] text-slate-500 font-mono">Meta: ${target}</span>
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
              <div class="h-full ${status === 'success' ? 'bg-emerald-500' : status === 'warning' ? 'bg-neon-amber' : 'bg-red-500'}" style="width: ${percentWidth}%;"></div>
            </div>
            <p class="text-[9px] text-slate-400 leading-relaxed italic border-t border-slate-900 pt-1.5 mt-1.5">
              <strong class="text-brand-red-neon block not-italic uppercase tracking-wider text-[8px] cyber-title">Plan:</strong> ${action}
            </p>
          </div>
        `;
      }

      function renderSummaryItem(title, val, target, status) {
        let textCol = 'text-red-500';
        let bgCol = 'bg-red-500';
        if (status === 'success') {
          textCol = 'text-emerald-400';
          bgCol = 'bg-emerald-500';
        } else if (status === 'warning') {
          textCol = 'text-amber-400';
          bgCol = 'bg-neon-amber';
        }

        return `
          <div class="flex items-center justify-between text-xs py-2.5 border-b border-slate-900 hover:bg-slate-900/10">
            <span class="text-slate-300 font-semibold">${title}</span>
            <div class="flex items-center gap-2">
              <span class="font-mono font-black ${textCol}">${val}</span>
              <i class="fa-solid fa-arrow-right text-[9px] text-slate-600"></i>
              <span class="font-mono font-bold text-slate-400">${target}</span>
              <span class="w-2 h-2 rounded-full ${bgCol} animate-pulse"></span>
            </div>
          </div>
        `;
      }

      function getBadgeClass(status) {
        if (status === 'success') return 'bg-emerald-950/80 border border-emerald-900/60 text-emerald-400';
        if (status === 'warning') return 'bg-amber-950/80 border border-amber-900/60 text-amber-400';
        return 'bg-red-950/80 border border-red-900/60 text-red-500';
      }

      function getBorderColorClass(status) {
        if (status === 'success') return 'border-emerald-500';
        if (status === 'warning') return 'border-amber-500';
        return 'border-red-500';
      }

      // CHARTJS RENDERERS
      function renderCharts() {
        if (!appState) return;

        // 1. Income Donut Chart
        const donutCtx = document.getElementById('incomeDonutChart');
        if (donutCtx) {
          if (charts.income) charts.income.destroy();
          charts.income = new Chart(donutCtx, {
            type: 'doughnut',
            data: {
              labels: appState.perspectiva_financiera.fuentes_ingreso.map(x => x.name),
              datasets: [{
                data: appState.perspectiva_financiera.fuentes_ingreso.map(x => x.value),
                backgroundColor: ['#ff3344', '#3b4352', '#ffab00'],
                borderWidth: 2,
                borderColor: '#12121c',
                hoverOffset: 4
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    color: '#94a3b8',
                    font: { family: 'Outfit', size: 10, weight: 'bold' }
                  }
                }
              },
              cutout: '65%'
            }
          });
        }

        // 2. Radar KPI Chart
        const radarCtx = document.getElementById('radarKpiChart');
        if (radarCtx) {
          if (charts.radar) charts.radar.destroy();
          
          let currentRadar = [...appState.perspectiva_aprendizaje.radar_chart.actual];
          let targetRadar = [...appState.perspectiva_aprendizaje.radar_chart.target];
          
          // Dynamic updates based on state
          currentRadar[0] = (appState.top_kpis.disponibilidad_hemocentro.value - 95) * 20; // scale to 0-100
          currentRadar[1] = (appState.top_kpis.madurez_digital.value / 5.0) * 100;
          currentRadar[2] = parseInt(appState.perspectiva_clientes.hemocentro.kpis[3].value);
          currentRadar[4] = appState.top_kpis.iso_27001.value;
          currentRadar[5] = appState.perspectiva_clientes.satisfaccion_soporte.global_csat.value * 10;
          
          if (appState.top_kpis.ciso_designado.value === 'SÍ') {
            currentRadar[3] = 100; // Integration
            currentRadar[4] = 90;  // ISO 27001
          } else {
            currentRadar[3] = (decisions.b3_api ? 80 : 0) + (decisions.b7_datos ? 20 : 0);
          }

          charts.radar = new Chart(radarCtx, {
            type: 'radar',
            data: {
              labels: appState.perspectiva_aprendizaje.radar_chart.labels,
              datasets: [
                {
                  label: 'Estado Actual 2026',
                  data: currentRadar,
                  fill: true,
                  backgroundColor: 'rgba(211, 47, 47, 0.15)',
                  borderColor: 'rgba(211, 47, 47, 0.85)',
                  pointBackgroundColor: '#ff3344',
                  pointBorderColor: '#fff',
                  pointHoverBackgroundColor: '#fff',
                  pointHoverBorderColor: 'rgba(211, 47, 47, 1)'
                },
                {
                  label: 'Meta PETI 2030',
                  data: targetRadar,
                  fill: true,
                  backgroundColor: 'rgba(0, 230, 118, 0.05)',
                  borderColor: 'rgba(0, 230, 118, 0.75)',
                  pointBackgroundColor: '#00e676',
                  pointBorderColor: '#fff',
                  pointHoverBackgroundColor: '#fff',
                  pointHoverBorderColor: 'rgba(0, 230, 118, 1)'
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    color: '#94a3b8',
                    font: { family: 'Outfit', size: 10, weight: 'bold' }
                  }
                }
              },
              scales: {
                r: {
                  grid: { color: 'rgba(255, 255, 255, 0.05)' },
                  angleLines: { color: 'rgba(255, 255, 255, 0.05)' },
                  pointLabels: {
                    color: '#94a3b8',
                    font: { family: 'Outfit', size: 9, weight: 'bold' }
                  },
                  ticks: { display: false },
                  min: 0,
                  max: 100
                }
              }
            }
          });
        }
      }

      // NAVIGATION TABS IMPLEMENT
      function initNavigation() {
        const tabs = document.querySelectorAll('.nav-tab');
        const views = document.querySelectorAll('.tab-view');

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const target = tab.getAttribute('data-tab');

            // Set active class on buttons
            tabs.forEach(t => {
              t.className = "nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer text-slate-400 hover:text-white";
            });
            tab.className = "nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-semibold flex-1 text-center transition-all cyber-title cursor-pointer bg-red-600/90 text-white glow-red";

            // Show view
            views.forEach(v => {
              v.classList.add('hidden');
              v.classList.remove('block');
            });
            
            const targetView = document.getElementById(`view-${target}`);
            if (targetView) {
              targetView.classList.remove('hidden');
              targetView.classList.add('block');
            }

            // Redraw Laser Paths on MAP BSC load
            if (target === 'mapa') {
              setTimeout(drawLaserPaths, 150);
            }
          });
        });
      }

      // MAP BSC INTERACTIVES & CONNECTION DRAW ENGINE
      function initBscInteractions() {
        const cards = document.querySelectorAll('.bsc-card');
        const detailsBox = document.getElementById('bsc-details-box');
        
        cards.forEach(card => {
          card.addEventListener('click', () => {
            const objId = card.getAttribute('data-obj');
            const data = bscObjectives[objId];
            
            if (data && detailsBox) {
              document.getElementById('details-perspective').textContent = data.perspective;
              document.getElementById('details-title').textContent = data.title;
              document.getElementById('details-impact').textContent = data.impact;
              document.getElementById('details-action').textContent = data.action;
              document.getElementById('details-path').textContent = `Cadena: ${data.path}`;
              
              // Handle reactive dynamic value updates in details panel
              let activeVal = data.value;
              if (objId === 'c1' || objId === 'f1') {
                activeVal = appState.top_kpis.disponibilidad_hemocentro.value + '%';
              } else if (objId === 'f2') {
                activeVal = appState.top_kpis.ejecucion_presupuesto.value + '%';
              } else if (objId === 'c2') {
                activeVal = appState.perspectiva_clientes.hospitales_b2b.confiabilidad;
              } else if (objId === 'p2') {
                activeVal = appState.top_kpis.iso_27001.value + '%';
              } else if (objId === 'a1') {
                activeVal = appState.top_kpis.madurez_digital.value + '';
              } else if (objId === 'c4' || objId === 'p4') {
                activeVal = appState.perspectiva_clientes.hemocentro.kpis[3].value;
              } else if (objId === 'p3') {
                activeVal = appState.perspectiva_procesos.kpis[2].value;
              }
              document.getElementById('details-value').textContent = activeVal;

              detailsBox.classList.remove('hidden');
              detailsBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          });
        });

        // Close details box
        const closeBtn = document.getElementById('close-bsc-details');
        if (closeBtn && detailsBox) {
          closeBtn.addEventListener('click', () => {
            detailsBox.classList.add('hidden');
          });
        }

        // Route filters highlight
        const filters = document.querySelectorAll('.route-filter');
        filters.forEach(filter => {
          filter.addEventListener('click', () => {
            filters.forEach(f => {
              f.className = "route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-slate-700 bg-slate-800/80 text-white cursor-pointer";
            });

            const route = filter.getAttribute('data-route');
            if (route === 'all') {
              filter.className = "route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-slate-700 bg-slate-800/80 text-white cursor-pointer active";
            } else if (route === 'r1') {
              filter.className = "route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-emerald-900/60 bg-emerald-950/60 text-emerald-400 cursor-pointer";
            } else if (route === 'r2') {
              filter.className = "route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-red-900/60 bg-red-950/60 text-brand-red-neon cursor-pointer";
            } else if (route === 'r3') {
              filter.className = "route-filter px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase border border-amber-900/60 bg-amber-950/60 text-amber-400 cursor-pointer";
            }

            drawLaserPaths(route);
          });
        });

        // SVG lines resize handle
        window.addEventListener('resize', () => {
          const activeFilter = document.querySelector('.route-filter.active') || document.querySelector('.route-filter[class*="bg-"]');
          const route = activeFilter ? activeFilter.getAttribute('data-route') : 'all';
          drawLaserPaths(route);
        });

        // Draw initial paths
        setTimeout(drawLaserPaths, 400);
      }

      // LASER LINE RENDERING ENGINE (Recalculates anchors dynamically on resize)
      function drawLaserPaths(activeRoute = 'all') {
        const svg = document.getElementById('svg-paths');
        if (!svg) return;

        // Clear existing paths
        svg.querySelectorAll('path').forEach(p => p.remove());

        // Connections Definitions
        const connections = [
          // R1: Hemocentro Causal Path (Emerald)
          { from: 'node-f1', to: 'node-a1', route: 'r1', stroke: 'url(#laser-grad-r1)' },
          { from: 'node-a1', to: 'node-a3', route: 'r1', stroke: 'url(#laser-grad-r1)' },
          { from: 'node-a3', to: 'node-p1', route: 'r1', stroke: 'url(#laser-grad-r1)' },
          { from: 'node-p1', to: 'node-p3', route: 'r1', stroke: 'url(#laser-grad-r1)' },
          { from: 'node-p3', to: 'node-c1', route: 'r1', stroke: 'url(#laser-grad-r1)' },

          // R2: Ciberseguridad Path (Blue)
          { from: 'node-f2', to: 'node-a2', route: 'r2', stroke: 'url(#laser-grad-r2)' },
          { from: 'node-a2', to: 'node-p2', route: 'r2', stroke: 'url(#laser-grad-r2)' },
          { from: 'node-p2', to: 'node-c2', route: 'r2', stroke: 'url(#laser-grad-r2)' },

          // R3: Educación Path (Amber)
          { from: 'node-f3', to: 'node-a1', route: 'r3', stroke: 'url(#laser-grad-r3)' },
          { from: 'node-a1', to: 'node-p4', route: 'r3', stroke: 'url(#laser-grad-r3)' },
          { from: 'node-p4', to: 'node-c3', route: 'r3', stroke: 'url(#laser-grad-r3)' }
        ];

        const svgRect = svg.getBoundingClientRect();

        connections.forEach(conn => {
          const fromEl = document.getElementById(conn.from);
          const toEl = document.getElementById(conn.to);

          if (!fromEl || !toEl) return;

          // Calculate center coordinates
          const fromRect = fromEl.getBoundingClientRect();
          const toRect = toEl.getBoundingClientRect();

          const x1 = (fromRect.left + fromRect.width / 2) - svgRect.left;
          const y1 = fromRect.top - svgRect.top; // Connect top of source
          const x2 = (toRect.left + toRect.width / 2) - svgRect.left;
          const y2 = (toRect.top + toRect.height) - svgRect.top; // Connect bottom of target

          // Check route state for highlighting/dimming
          const isActive = (activeRoute === 'all' || conn.route === activeRoute);
          const opacity = isActive ? '0.85' : '0.07';
          const strokeWidth = isActive ? '3.5' : '1.5';
          const animClass = isActive ? 'laser-path' : '';

          // Create SVG curve path
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          
          // Draw smooth bezier curve
          const controlDist = Math.abs(y2 - y1) * 0.45;
          const d = `M ${x1} ${y1} C ${x1} ${y1 - controlDist}, ${x2} ${y2 + controlDist}, ${x2} ${y2}`;
          
          path.setAttribute('d', d);
          path.setAttribute('stroke', conn.stroke);
          path.setAttribute('stroke-width', strokeWidth);
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke-linecap', 'round');
          path.setAttribute('opacity', opacity);
          
          if (animClass) {
            path.setAttribute('class', animClass);
          }

          svg.appendChild(path);
        });
      }

      // UTILITY SYSTEM TOAST ALERTS
      function showToast(text, title = "Alerta n8n Activada") {
        const toast = document.getElementById('alert-toast');
        const toastTitle = document.getElementById('alert-toast-title');
        const toastText = document.getElementById('alert-toast-text');
        
        if (toast && toastText && toastTitle) {
          toastTitle.textContent = title;
          toastText.textContent = text;
          toast.classList.remove('hidden');
          setTimeout(() => {
            toast.classList.add('hidden');
          }, 4500);
        }
      }

      // SYNC CONTROL PANEL INPUTS BACK FROM THE COMPUTED STATE
      function syncInputsWithState() {
        // Sync checkboxes according to decisions object
        document.getElementById('audit-servidores').checked = decisions.audit_servidores;
        document.getElementById('audit-seguridad').checked = decisions.audit_seguridad;
        document.getElementById('audit-procesos').checked = decisions.audit_procesos;
        
        document.getElementById('dirigir-b1').checked = decisions.b1_ciso;
        document.getElementById('dirigir-b2').checked = decisions.b2_azure;
        document.getElementById('dirigir-b3').checked = decisions.b3_api;
        document.getElementById('dirigir-b5').checked = decisions.b5_portal;
        document.getElementById('dirigir-b7').checked = decisions.b7_datos;
        document.getElementById('dirigir-b8').checked = decisions.b8_capacitacion;
      }
    </script>

