        "f1": { title: "Asegurar disponibilidad TI crítica del Hemocentro", perspective: "Financiero", value: "99.1% disp.", target: "Meta 2030: 99.8%", impact: "Es la base que habilita el 60% de los ingresos de la seccional. Sin disponibilidad TI, la captación y distribución de sangre se paraliza.", action: "Garantizar redundancia de conectividad a internet local aprobando el proyecto de migración Azure (B2).", path: "R1 - Hemocentro" },
        "f2": { title: "Optimizar ejecución presupuestal TI (desviación < 10%)", perspective: "Financiero", value: "67% ejec.", target: "Meta: ≤10% desv.", impact: "Garantiza que la asignación del PETI se gaste eficientemente y no se pierdan recursos por retrasos en compras o despliegues.", action: "Evaluar desviaciones contables y aprobar convenios estratégicos que optimicen costos operativos.", path: "R2 - Ciberseguridad" },
        "f3": { title: "Reducir costo operativo TI con Cloud y n8n", perspective: "Financiero", value: "50% ahorro", target: "Meta: 100% conv.", impact: "El licenciamiento en ONGs mediante MAKAIA y Microsoft permite liberar presupuesto administrativo para misiones humanitarias.", action: "Migrar el 100% de licencias al convenio Makaia y automatizar reportes con n8n para reducir horas de personal administrativo.", path: "R3 - Educación" }
      };

      // INTERACTIVE STATE (Unified ISO 38500 Matrix Decisions)
      let decisions = {
        audit_servidores: false,
        audit_seguridad: false,
        audit_procesos: false,
        b1_ciso: false,
        b2_azure: false,
        b3_api: false,
        b5_portal: false,
        b7_datos: false,
        b8_capacitacion: false
      };

      // WINDOW LOAD INITS
      window.addEventListener('DOMContentLoaded', async () => {
        appState = JSON.parse(JSON.stringify(localFallbackData));
        
        initNavigation();
        initBscInteractions();
        initISO38500Console();
        
        // Initial recalculation & render
        recalculateAndRender();
      });

      // CONSOLE CONTROLS WIRE UP (ISO 38500 Evaluaciones & Directivas)
      function initISO38500Console() {
        
        // Restablecer Button
        const resetBtn = document.getElementById('btn-reset-data');
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            // Reset all decisions
            Object.keys(decisions).forEach(key => {
              decisions[key] = false;
              const el = document.getElementById(key.replace('_', '-'));
              if (el) {
                if (el.type === 'checkbox') el.checked = false;
              }
            });

            // Trigger recalc
            recalculateAndRender();

            // Success feedback toast
            showToast("Métricas y directivas del PETI de la Cruz Roja restablecidas al estado base oficial.", "Éxito Gobierno TI");
          });
        }

        // Checklist/Checkbox selectors
        const inputs = ['audit_servidores', 'audit_seguridad', 'audit_procesos', 'b1_ciso', 'b2_azure', 'b3_api', 'b5_portal', 'b7_datos', 'b8_capacitacion'];
        
        inputs.forEach(id => {
          const el = document.getElementById(id.replace('_', '-'));
          if (el) {
            el.addEventListener('change', () => {
              decisions[id] = el.checked;
              recalculateAndRender();
            });
          }
        });

        // Forced SLA trigger button
        const forceBtn = document.getElementById('trigger-sim-n8n');
        if (forceBtn) {
          forceBtn.addEventListener('click', () => {
            const currentUptime = appState.top_kpis.disponibilidad_hemocentro.value;
            if (currentUptime < 99.5) {
              showToast(`CRÍTICO: Disponibilidad del Hemocentro en ${currentUptime}% violó el SLA del 99.5%. Correo enviado automáticamente al CIO.`, "Alerta n8n Activada");
            } else {
              showToast(`ESTABLE: Disponibilidad correcta al ${currentUptime}%. n8n verificó SLA estable.`, "Monitoreo n8n");
            }
          });
        }
      }

      // MATHEMATICAL RECALCULATOR & RENDER (The absolute core of reactive architecture!)
      function recalculateAndRender() {
        if (!appState) return;

        // Reset state to fallback base
        appState = JSON.parse(JSON.stringify(localFallbackData));

        // 1. CALCULATE BUDGET INVERSION (PETI Project allocation)
        // Base executed budget already spent is $60M (contratos vigentes de operación)
        let totalCost = 60;
        if (decisions.b1_ciso) totalCost += 45;
        if (decisions.b2_azure) totalCost += 80;
        if (decisions.b3_api) totalCost += 55;
        if (decisions.b5_portal) totalCost += 75;
        if (decisions.b7_datos) totalCost += 12;
        if (decisions.b8_capacitacion) totalCost += 15;

        const budgetPercent = Math.round((totalCost / 330) * 100);
        appState.top_kpis.ejecucion_presupuesto.value = budgetPercent;
        appState.perspectiva_financiera.presupuesto_ti.amount = `${budgetPercent}%`;
        
        // Budget SLA condition: executed budget cannot exceed 100% of $330M
        const budgetWarning = document.getElementById('sim-budget-warning');
        if (totalCost > 330) {
          appState.top_kpis.ejecucion_presupuesto.status = 'danger';
          if (budgetWarning) budgetWarning.classList.remove('hidden');
        } else {
          appState.top_kpis.ejecucion_presupuesto.status = budgetPercent >= 90 ? 'success' : 'warning';
          if (budgetWarning) budgetWarning.classList.add('hidden');
        }

        // Sync Sidebar budget strip
        const budgetCostEl = document.getElementById('sim-budget-cost');
        if (budgetCostEl) budgetCostEl.textContent = `$${totalCost}M / $330M`;
        const budgetProgressEl = document.getElementById('sim-budget-progress');
        if (budgetProgressEl) {
          const barWidth = Math.min((totalCost / 330) * 100, 100);
          budgetProgressEl.style.width = `${barWidth}%`;
          if (totalCost > 330) {
            budgetProgressEl.className = "h-full bg-red-650";
          } else {
            budgetProgressEl.className = "h-full bg-neon-green";
          }
        }

        // 2. RECALCULATE LEARNING (Maturity calculated based on audits and training)
        let digitalMaturity = 2.8;
        if (decisions.audit_procesos) digitalMaturity += 0.2; // Audit satisfaction voluntaries gives awareness
        if (decisions.b8_capacitacion) digitalMaturity += 1.2; // Project B8 capacitación raises it directly!
        appState.top_kpis.madurez_digital.value = parseFloat(digitalMaturity.toFixed(1));
        
        appState.top_kpis.madurez_digital.status = digitalMaturity >= 4.0 ? 'success' : digitalMaturity >= 3.0 ? 'warning' : 'danger';
        
        if (decisions.b8_capacitacion) {
          appState.perspectiva_aprendizaje.personal_certificado.value = "95%";
          appState.perspectiva_aprendizaje.practicas_cobit.value = "80%";
          appState.perspectiva_aprendizaje.personal_certificado.status = "success";
          appState.perspectiva_aprendizaje.practicas_cobit.status = "success";
        }

        // 3. RECALCULATE UPTIME (Azure migration impact)
        let currentUptime = 99.1;
        if (decisions.audit_servidores) currentUptime = 99.1; // Audit alone doesn't raise uptime
        if (decisions.b2_azure) currentUptime = 99.8; // Aproved cloudAzure hybrid raises uptime to 99.8%!
        appState.top_kpis.disponibilidad_hemocentro.value = currentUptime;
        appState.top_kpis.disponibilidad_hemocentro.status = currentUptime >= 99.5 ? 'success' : 'danger';

        // 4. RECALCULATE SECURITY & COMPLIANCE (CISO & SOC impact)
        let currentISO = 45;
        if (decisions.audit_seguridad) currentISO = 45;
        if (decisions.b1_ciso) currentISO = 90; // Approved CISO SOC raises compliance immediately to 90%!
        appState.top_kpis.iso_27001.value = currentISO;
        appState.top_kpis.iso_27001.status = currentISO >= 90 ? 'success' : currentISO >= 70 ? 'warning' : 'danger';
        appState.top_kpis.ciso_designado.value = decisions.b1_ciso ? "SÍ" : "NO";
        appState.top_kpis.ciso_designado.status = decisions.b1_ciso ? "success" : "danger";

        // Hospitals perception of reliability B2B linked to ISO 27001
        appState.perspectiva_clientes.hospitales_b2b.confiabilidad = `${currentISO}%`;
        appState.perspectiva_clientes.hospitales_b2b.status = currentISO >= 90 ? 'success' : currentISO >= 70 ? 'warning' : 'danger';
        appState.perspectiva_clientes.hospitales_b2b.status_text = currentISO >= 90 ? 'Excelente' : currentISO >= 70 ? 'En desarrollo' : 'Riesgo alto';

        // 5. RECALCULATE INTEGRATIONS (API Gateway & Data Governance)
        let systemIntegration = 0;
        if (decisions.b3_api) systemIntegration += 80;
        if (decisions.b7_datos) systemIntegration += 20;
        appState.perspectiva_procesos.kpis[2].value = `${systemIntegration}%`;
        appState.perspectiva_procesos.kpis[2].status = systemIntegration >= 100 ? 'success' : systemIntegration >= 50 ? 'warning' : 'danger';
        appState.perspectiva_procesos.kpis[2].status_text = systemIntegration >= 100 ? 'Estable' : systemIntegration >= 20 ? 'Islas' : 'Inexistente';

        // 6. RECALCULATE CLIENTS & PORTAL B5 (Adoption & App)
        let digitalTramites = 30;
        let appProgress = "0%";
        if (decisions.b5_portal) {
          // Principle of Strategy / Acquisition ISO 38500 Constraint:
          // Aproved portal B5 needs Azure B2 (infrastructure) and CISO B1 (security) to perform successfully.
          if (decisions.b2_azure && decisions.b1_ciso) {
            digitalTramites = 90;
            appProgress = "100%";
            appState.perspectiva_clientes.hemocentro.kpis[1].status = 'success';
            appState.perspectiva_clientes.hemocentro.kpis[3].status = 'success';
            appState.perspectiva_clientes.educacion.portal_avance = '100%';
            appState.perspectiva_clientes.educacion.status = 'success';
            appState.perspectiva_clientes.educacion.status_text = 'Estable';
          } else {
            digitalTramites = 50; // Portal launched on unsafe servers - Partial
            appProgress = "0% (Bloqueado)";
            appState.perspectiva_clientes.hemocentro.kpis[1].status = 'danger';
            appState.perspectiva_clientes.hemocentro.kpis[3].status = 'warning';
            appState.perspectiva_clientes.educacion.portal_avance = '0% (Falla)';
            appState.perspectiva_clientes.educacion.status = 'danger';
            appState.perspectiva_clientes.educacion.status_text = 'Falla de seguridad';
          }
        }
        appState.perspectiva_clientes.hemocentro.kpis[1].value = appProgress;
        appState.perspectiva_clientes.hemocentro.kpis[3].value = `${digitalTramites}%`;
        appState.perspectiva_procesos.kpis[3].value = `${digitalTramites}%`;
        appState.perspectiva_procesos.kpis[3].status = digitalTramites >= 80 ? 'success' : 'warning';

        // 7. CLIENT DYNAMIC RECOMMENDATIONS CONSOLE (Under ISO 38500)
        let clientRecText = "";
        if (!decisions.b5_portal) {
          clientRecText = "📢 **EVALUAR Y DIRIGIR:** El portal educativo de matrículas y la App de donaciones del Hemocentro se encuentran inactivos. Se recomienda coordinar la aprobación del **Proyecto B5 (Hemocentro 4.0)** en la consola de dirección para mitigar la desintermediación del Instituto y modernizar los trámites.";
        } else if (decisions.b5_portal && (!decisions.b2_azure || !decisions.b1_ciso)) {
          clientRecText = "⚠️ **INCUMPLIMIENTO GRAVE ISO 38500:** El portal y la app móvil de donación se han lanzado al público, pero la infraestructura física está obsoleta (sin servidores en Azure) y se carece de gobernanza de seguridad (sin CISO). **Riesgo crítico de caída de servicio y brecha de datos de pacientes**. Directiva del CIO Valle: suspender de inmediato el portal PSE hasta garantizar infraestructura segura.";
        } else {
          clientRecText = "✅ **MONITOREAR - ALINEACIÓN TI-NEGOCIO COMPLETA:** Se ha consolidado el lanzamiento seguro de la App Móvil y el portal transaccional PSE del Hemocentro en la nube de Azure y bajo el monitoreo activo del SOC del CISO Valle. Satisfacción del donante al 99.8% certificada por auditoría. La interoperabilidad digital con hospitales funciona exitosamente.";
        }
        
        const cliRecEl = document.getElementById('client-dynamic-recommendation');
        if (cliRecEl) cliRecEl.innerHTML = clientRecText;

        // 8. ISO 38500 DIRECTIVE RATING RATER
        let totalEvaluations = (decisions.audit_servidores ? 1 : 0) + (decisions.audit_seguridad ? 1 : 0) + (decisions.audit_procesos ? 1 : 0);
        let totalDirections = (decisions.b1_ciso ? 1 : 0) + (decisions.b2_azure ? 1 : 0) + (decisions.b3_api ? 1 : 0) + (decisions.b5_portal ? 1 : 0) + (decisions.b7_datos ? 1 : 0) + (decisions.b8_capacitacion ? 1 : 0);

        const ratingEl = document.getElementById('iso-38500-rating');
        if (ratingEl) {
          if (totalEvaluations === 0) {
            ratingEl.textContent = "EVALUANDO";
            ratingEl.className = "font-mono font-bold text-red-500 bg-red-950/45 px-2 py-0.5 rounded border border-red-900/60 uppercase tracking-widest text-[9px]";
          } else if (totalCost > 330) {
            ratingEl.textContent = "SOBRE-PRESUPUESTO";
            ratingEl.className = "font-mono font-bold text-red-500 bg-red-950/45 px-2 py-0.5 rounded border border-red-900/60 uppercase tracking-widest text-[9px]";
          } else if (decisions.b5_portal && (!decisions.b2_azure || !decisions.b1_ciso)) {
            ratingEl.textContent = "INCUMPLIMIENTO RIESGO";
            ratingEl.className = "font-mono font-bold text-red-500 bg-red-950/45 px-2 py-0.5 rounded border border-red-900/60 uppercase tracking-widest text-[9px]";
          } else if (totalEvaluations >= 2 && totalDirections >= 5) {
            ratingEl.textContent = "GOBERNANZA COMPLETA";
            ratingEl.className = "font-mono font-bold text-emerald-455 bg-emerald-950/45 px-2 py-0.5 rounded border border-emerald-900/60 uppercase tracking-widest text-[9px]";
          } else {
            ratingEl.textContent = "GOBIERNO PARCIAL";
            ratingEl.className = "font-mono font-bold text-amber-400 bg-amber-950/45 px-2 py-0.5 rounded border border-amber-900/60 uppercase tracking-widest text-[9px]";
          }
        }

        // Render everything to UI
        renderDashboard();
      }

      // RENDER BASE TEMPLATES
      function renderDashboard() {
        if (!appState) return;

        // Update Top Strip Metrics (Values and colors)
        updateTopKpi('madurez', appState.top_kpis.madurez_digital.value, '/5.0', appState.top_kpis.madurez_digital.status);
        updateTopKpi('iso', appState.top_kpis.iso_27001.value + '%', '', appState.top_kpis.iso_27001.status);
        updateTopKpi('uptime', appState.top_kpis.disponibilidad_hemocentro.value + '%', '', appState.top_kpis.disponibilidad_hemocentro.status);
        updateTopKpi('presupuesto', appState.top_kpis.ejecucion_presupuesto.value + '%', '', appState.top_kpis.ejecucion_presupuesto.status);
        updateTopKpi('ciso', appState.top_kpis.ciso_designado.value, '', appState.top_kpis.ciso_designado.status);
        
        // Update BSC Map Card Badges
        updateBscCardKpi('c1', `${appState.top_kpis.disponibilidad_hemocentro.value}% disp.`, appState.top_kpis.disponibilidad_hemocentro.status);
        updateBscCardKpi('c2', `Confianza ${appState.perspectiva_clientes.hospitales_b2b.confiabilidad}`, appState.perspectiva_clientes.hospitales_b2b.status);
        updateBscCardKpi('c3', `Portal ${appState.perspectiva_clientes.educacion.portal_avance}`, appState.perspectiva_clientes.educacion.status);
        updateBscCardKpi('p2', `ISO ${appState.top_kpis.iso_27001.value}%`, appState.top_kpis.iso_27001.status);
