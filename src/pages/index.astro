          <div id="n8n-view-technical" class="hidden grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-900 h-[460px] bg-slate-950/20">
            <!-- Left side: JSON Request -->
            <div class="p-5 flex flex-col justify-between h-full overflow-hidden">
              <div class="overflow-hidden flex flex-col h-full">
                <span class="text-xs text-cyan-400 font-bold uppercase tracking-widest cyber-title block mb-2">HTTP POST REQUEST PAYLOAD</span>
                <div class="bg-slate-950/85 border border-slate-900 rounded-xl p-4 font-mono text-[9.5px] text-cyan-300 leading-normal overflow-y-auto flex-1 h-full shadow-inner scrollbar-thin">
                  <pre id="n8n-payload-code" class="whitespace-pre-wrap break-all select-all">Generando payload...</pre>
                </div>
              </div>
            </div>

            <!-- Right side: JSON Response -->
            <div class="p-5 flex flex-col justify-between h-full overflow-hidden">
              <div class="overflow-hidden flex flex-col h-full">
                <span class="text-xs text-emerald-400 font-bold uppercase tracking-widest cyber-title block mb-2">HTTP RESPONSE (data.json)</span>
                
                <!-- Loader / Response box -->
                <div class="flex-1 flex flex-col justify-center min-h-[160px] h-full overflow-hidden">
                  <!-- Loading spinner -->
                  <div id="n8n-spinner" class="flex flex-col items-center justify-center py-4">
                    <i class="fa-solid fa-spinner animate-spin text-cyan-400 text-3xl"></i>
                    <span class="text-[10px] text-cyan-400 font-bold uppercase tracking-widest cyber-title mt-3 animate-pulse">Procesando en n8n...</span>
                  </div>

                  <!-- Response JSON view -->
                  <div id="n8n-response-box" class="hidden flex flex-col h-full overflow-hidden">
                    <div class="bg-slate-950/85 border border-slate-900 rounded-xl p-4 font-mono text-[9.5px] text-emerald-400 leading-normal overflow-y-auto flex-1 h-full shadow-inner scrollbar-thin">
                      <pre id="n8n-response-payload" class="whitespace-pre-wrap select-all">Alineación exitosa...</pre>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

